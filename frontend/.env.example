# Copy to .env and fill in for local dev. On Vercel, set these as Environment
# Variables in the project dashboard instead (Root Directory = frontend).

# Local dev: http://localhost:8000. Production: your deployed backend's URL
# (Vercel can't host the backend — see backend/README on where it runs).
REACT_APP_BACKEND_URL=http://localhost:8000

# Public — safe to expose (Google OAuth client IDs are not secret). Must match
# GOOGLE_CLIENT_ID in backend/.env, and this origin must be registered as an
# Authorized JavaScript origin + redirect URI on that OAuth client.
REACT_APP_GOOGLE_CLIENT_ID=

ENABLE_HEALTH_CHECK=false
