# Copy to .env and fill in. Real values must never be committed.

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers).
MONGO_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="test_database"
CORS_ORIGINS="*"
APP_NAME=indifferent

# Google OAuth (console.cloud.google.com/apis/credentials -> Create OAuth client
# -> Web application). Add both your frontend origin and <FRONTEND_URL>/auth/callback
# under Authorized JavaScript origins / redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Groq (console.groq.com/keys) — fast, free tier, no credit card.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# false for local http:// dev; true once frontend+backend are on real HTTPS domains.
COOKIE_SECURE=false

# LiveKit Cloud (livekit.io) project credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Vercel Blob (dashboard -> Storage -> Blob -> your store -> .env.local tab) —
# object storage for clip uploads and ID-verification documents. Blank =
# uploads 503 "Upload storage not configured".
BLOB_READ_WRITE_TOKEN=

# Your deployed frontend origin (used to build Stripe Checkout redirect URLs).
FRONTEND_URL=http://localhost:3000

# Stripe (test mode) — two separate products, see backend/app/routers/payments.py.
# Blank = payments endpoints 503 "Payments not configured".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MEMBERSHIP=
STRIPE_PRICE_ID_DEBATER=

# Trust & safety. true = every ID-verification upload auto-approves (no
# review queue); false = real manual review via the admin portal
# (GET /verify/pending, POST /verify/{user_id}/decide).
VERIFY_AUTO_APPROVE=true

# Comma-separated emails allowed to hit admin-only endpoints (user
# management, verification review, reports). Defaults to the project
# owner's own email if unset.
ADMIN_EMAILS=
